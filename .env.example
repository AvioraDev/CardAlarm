# Local SQLite fallback for import tooling
SQLITE_DB_PATH=./cardalarm.db

# Supabase project URL. This is not a Postgres connection string.
SUPABASE_PROJECT_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Postgres connection strings. Never expose these to client code.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_POSTGRES_URL_NON_POOLING=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Set to false only for local development/admin migration if Node does not trust the Supabase certificate chain.
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
SUPABASE_DB_SSL_REJECT_UNAUTHORIZED=true

# Optional scanner tuning. Defaults are polite for daily scans; lower only for local testing.
CARDALARM_PAGE_CONCURRENCY=1
CARDALARM_PAGE_SIZE=100
CARDALARM_EARLY_STOP_UNCHANGED_PAGES=2
CARDALARM_FETCH_TIMEOUT_MS=15000
CARDALARM_SCAN_DELAY_MIN_MS=2000
CARDALARM_SCAN_DELAY_MAX_MS=5000
