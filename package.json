{
  "name": "cardalarm",
  "private": true,
  "scripts": {
    "seed": "node seed.js",
    "engine:dev": "tsx watch engine/src/index.ts",
    "engine:start": "tsx engine/src/index.ts",
    "worker:once": "tsx engine/src/worker.ts",
    "worker:loop": "tsx engine/src/worker.ts --loop",
    "web:dev": "cd web && npm run dev",
    "web:build": "cd web && npm run build",
    "test": "jest --config jest.config.js",
    "db:migrate:supabase": "node scripts/migrate-sqlite-to-supabase.js --apply-schema",
    "db:migrate:supabase:reset": "node scripts/migrate-sqlite-to-supabase.js --apply-schema --truncate",
    "db:migrate:supabase:dry-run": "node scripts/migrate-sqlite-to-supabase.js --dry-run",
    "classify:backfill": "tsx engine/src/backfill-product-classifications.ts",
    "supabase:migrations:list": "node scripts/supabase-cli.js list",
    "supabase:migrations:dry-run": "node scripts/supabase-cli.js dry-run",
    "supabase:migrations:push": "node scripts/supabase-cli.js push"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "node-cron": "^3.0.3",
    "pg": "^8.20.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
